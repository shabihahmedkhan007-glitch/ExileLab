# ExileLab API environment — copy this file to `.env` in backend/api/ and fill in.
# `.env` is gitignored; NEVER commit real keys. Shell env vars override this file.

# ── Build Coach (AI narration) ───────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys — without it the coach is simply off
# (no ✨ narration cards; everything else works).
OPENROUTER_API_KEY=

# Narration model — change this line anytime and restart the API; no code edits.
# (The value below is also the built-in default when this line is removed.)
# The ladder, cheapest → best (per 100k narrations):
#   qwen/qwen3-next-80b-a3b-instruct:free    $0   — but upstream rate-limits hard
#                                                   (429s); unreliable for live use
#   inclusionai/ling-2.6-flash               ~$1  — DEFAULT: cheapest that WORKS
#   qwen/qwen3-30b-a3b-instruct-2507         ~$5
#   openai/gpt-4.1-nano                      ~$10 — grammar-enforced schema, fastest
#   anthropic/claude-haiku-4.5               ~$100 — best discipline
# Any OpenRouter model id works: https://openrouter.ai/models
COACH_MODEL=inclusionai/ling-2.6-flash

# Force the coach off even with a key present.
# COACH_ENABLED=false

# ── Price layer (Upgrades tab) ───────────────────────────────────────────────
# 'mock' (default) = deterministic synthetic prices, visibly disclaimed.
# Any other value kills the price layer (Upgrades 503s, Tune drops cost chips).
# PRICE_PROVIDER=mock

# ── Persistence ──────────────────────────────────────────────────────────────
# Unset = in-memory. Set to use Postgres 17 (see docker-compose.db.yml):
# DATABASE_URL=postgres://exilelab:exilelab@localhost:5433/exilelab

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=3001
# HOST=127.0.0.1
# CORS_ORIGIN=http://localhost:3000
